[Unit]
Description=Renatum continuous filesystem versioning daemon
Documentation=https://github.com/zmushko/renatum
After=local-fs.target
Requires=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/renatumd --foreground
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Privileges
# renatumd needs read access to watched paths and write access to
# /var/lib/renatum/. Running as root is the simplest path; tighten
# with User= + AmbientCapabilities= for production.
# User=renatum
# AmbientCapabilities=CAP_DAC_READ_SEARCH

# Resource limits
LimitNOFILE=65536

# Hardening (relax if it breaks something on your system)
ProtectSystem=strict
ReadWritePaths=/var/lib/renatum /var/log/renatum /run/renatum
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
